{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "knowledge-link.v1",
  "title": "知识链接建议列表",
  "description": "只是建议，用户确认后才写入 knowledge_links（C1）",
  "type": "array",
  "maxItems": 5,
  "items": {
    "type": "object",
    "required": ["toId", "relationType", "reason", "confidence"],
    "additionalProperties": false,
    "properties": {
      "toId": {
        "description": "必须来自候选集，orchestrator 会再校验一次",
        "type": "string",
        "minLength": 1
      },
      "toType": {
        "description": "通用端点类型（§13.5）。MVP 只用 note / chunk，扩展需升 Schema 版本",
        "type": "string",
        "enum": ["note", "chunk", "concept", "todo", "review_item"],
        "default": "chunk"
      },
      "relationType": {
        "description": "固定枚举，模型不得发明新值（C9）",
        "type": "string",
        "enum": [
          "same_concept",
          "prerequisite",
          "example_of",
          "contrast",
          "extends",
          "review_later"
        ]
      },
      "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
    }
  }
}
