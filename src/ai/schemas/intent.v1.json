{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "intent.v1",
  "title": "意图识别结果",
  "type": "object",
  "required": ["intent", "confidence"],
  "additionalProperties": false,
  "properties": {
    "intent": {
      "description": "固定枚举，模型不得发明新值（C9）",
      "type": "string",
      "enum": [
        "create_todo",
        "search_notes",
        "start_focus",
        "generate_review",
        "socratic",
        "other"
      ]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "entities": {
      "description": "输入中明确出现的信息，允许为空对象",
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
