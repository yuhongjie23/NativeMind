      "properties": {
        "kind": { "type": "string", "enum": ["observation", "suggestion"] },
        "index": { "type": "integer", "minimum": 0, "maximum": 2 },
        "evidenceId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "quote": { "type": "string", "minLength": 4, "maxLength": 500 }
      }
    } }
  }
}
